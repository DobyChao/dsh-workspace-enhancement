# The dsh-tools / dsh-system-prompt peers are HARNESS-HOSTED packages (the dsh
# profile provides them; see package.json peerDependencies). Their prerelease
# peer networks do not form a resolvable tree inside this plugin repo, so the
# harness-standard resolution is `--legacy-peer-deps` — identical to how the
# deployment links peers from the profile's own node_modules.
legacy-peer-deps=true
